# ---------------------------------------------------------------------------
# BaaS Connector — configuracao de exemplo
#
# Copie para `.env` e ajuste. Nenhum valor aqui e segredo real: os que estao
# preenchidos servem apenas para `docker compose up` funcionar de primeira.
#
# A API valida esta configuracao NO BOOT e se recusa a subir com segredo
# faltando. Descobrir que a chave mestra do KMS nao esta configurada na
# primeira gravacao de credencial e pior do que nao subir.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
# Porta separada de proposito: /metrics num listener publico e vazamento
# (nomes de conexao, volumes) e vetor de DoS barato.
METRICS_PORT=9464

# --- Infraestrutura --------------------------------------------------------
DATABASE_URL=postgresql://baas:baas@localhost:5432/baas?schema=public
# O Mock Bank tem banco PROPRIO, sem foreign key nenhuma para as tabelas do
# conector: ele precisa ser genuinamente externo, senao os testes de contrato
# poderiam trapacear com join e um bug real de integracao nunca apareceria.
MOCK_BANK_DATABASE_URL=postgresql://baas:baas@localhost:5432/baas_mockbank?schema=public
REDIS_URL=redis://localhost:6379

# --- Criptografia ----------------------------------------------------------
# `local` guarda a chave mestra numa variavel de ambiente. Serve para
# desenvolvimento; em producao a API SE RECUSA a subir com este driver.
KMS_DRIVER=local
KMS_MASTER_SECRET=troque-este-segredo-mestre-de-desenvolvimento
# KMS_KEY_ID=arn:aws:kms:sa-east-1:000000000000:key/00000000-0000-0000-0000-000000000000

# Pepper do blind index: e o que torna "achar a conta do CPF X" possivel sem
# descriptografar a tabela inteira. Vive no KMS ou no secret manager, NUNCA no
# banco — sem ele, 11 digitos sao enumeraveis em minutos.
BLIND_INDEX_PEPPER=troque-este-pepper-com-ao-menos-32-caracteres

# --- Sessao do console -----------------------------------------------------
# Par RSA. Gere com:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Assimetrico porque a chave privada fica so na API; quem precisa validar o
# token recebe apenas a publica.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- API -------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3001
CONSOLE_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT_MS=30000
# Janela da assinatura HMAC nas rotas que movimentam dinheiro.
SIGNATURE_TOLERANCE=300
# Mensagem crua do provedor no corpo do erro. Desligar em producao.
EXPOSE_PROVIDER_MESSAGES=true

# --- Cache -----------------------------------------------------------------
# Saldo servido do cache e CONSULTIVO e a resposta sempre declara a frescura.
# Os bypasses obrigatorios (autorizacao de PIX out, ?consistency=strong, break
# de conciliacao aberto, ...) sao impostos por codigo, nao por configuracao.
BALANCE_CACHE_TTL=30
POST_MUTATION_BYPASS=60
# Incrementar e o "limpar tudo" no deploy quando um formato de serializacao muda.
CACHE_VERSION=1

# --- Observabilidade -------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
# Sem endpoint, o SDK de OpenTelemetry nem e carregado.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_ARG=0.1

# --- Mock Bank -------------------------------------------------------------
# `memory` troca os repositorios Prisma por in-memory: a suite de conformidade
# sobe in-process, sem Postgres.
MOCK_BANK_STORE=memory
MOCK_BANK_PORT=3002
MOCK_APPROVAL_DELAY_MS=0
MOCK_REVIEW_DELAY_MS=0
