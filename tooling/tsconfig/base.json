// Base de TODO tsconfig do repositorio.
//
// Vive DENTRO de `@baasconn/tsconfig`, e nao na raiz, porque `turbo prune`
// so leva os pacotes do workspace: um `extends` que aponta para fora do
// pacote simplesmente nao existe dentro da imagem Docker. O sintoma nao era
// um erro de arquivo ausente e sim `TS2737: BigInt literals are not
// available when targeting lower than ES2020` — o tsc caiu no target padrao
// e o build da imagem morreu com a suite local inteira verde.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "exclude": ["node_modules", "dist", ".next"]
}
