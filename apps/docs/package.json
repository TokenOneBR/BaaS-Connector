{
  "name": "@baasconn/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentacao publica do BaaS Connector",
  "scripts": {
    "build": "tsx sync-docs.ts && docusaurus build",
    "dev": "tsx sync-docs.ts && docusaurus start",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'sem lint proprio: o conteudo e Markdown e passa pelo prettier da raiz'",
    "sync": "tsx sync-docs.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.7.0",
    "@docusaurus/preset-classic": "3.7.0",
    "@mdx-js/react": "^3.0.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.7.0",
    "@docusaurus/tsconfig": "3.7.0",
    "@docusaurus/types": "3.7.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.11"
  }
}
