{
  "name": "@baasconn/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Consumidores de fila: webhooks, outbox, conciliacao e polling",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.mts"
  },
  "dependencies": {
    "@baasconn/api": "workspace:*",
    "@baasconn/contracts": "workspace:*",
    "@baasconn/crypto": "workspace:*",
    "@baasconn/db": "workspace:*",
    "@baasconn/ledger": "workspace:*",
    "@baasconn/observability": "workspace:*",
    "@baasconn/provider-spi": "workspace:*",
    "@baasconn/reconciliation": "workspace:*",
    "@baasconn/taxonomy": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "bullmq": "^5.81.0",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@baasconn/eslint-config": "workspace:*",
    "@baasconn/tsconfig": "workspace:*",
    "@baasconn/vitest-config": "workspace:*",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
