{
  "name": "@baasconn/ledger",
  "version": "0.1.0",
  "description": "Motor de partidas dobradas em duas fases, compartilhado pelo Mock Bank (autoritativo) e pelo conector (sombra)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@baasconn/taxonomy": "workspace:*"
  },
  "devDependencies": {
    "@baasconn/tsconfig": "workspace:*",
    "@baasconn/vitest-config": "workspace:*",
    "eslint": "^10.9.1",
    "fast-check": "^3.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
