enum IdempotencyState {
  IN_FLIGHT
  COMPLETED
  FAILED
}

/// Registro de idempotencia.
///
/// No POSTGRES e nao no Redis: precisa estar na MESMA transacao da escrita de
/// dominio para a garantia de "exatamente um efeito colateral" valer. Redis
/// mais Postgres sao dois sistemas que podem discordar. Ver ADR 0010.
model IdempotencyRecord {
  id          String      @id @db.VarChar(40)
  environment Environment
  apiKeyId    String      @map("api_key_id") @db.VarChar(40)
  /// Identidade da rota, ex.: "POST /v1/accounts/:id/pix/transfers".
  endpointKey String      @map("endpoint_key") @db.VarChar(255)
  key         String      @db.VarChar(255)
  /// sha256 do corpo canonicalizado + params + connectionId.
  requestFingerprint String @map("request_fingerprint") @db.VarChar(64)

  state IdempotencyState @default(IN_FLIGHT)
  /// ULID cunhado uma vez. E ELE que vira a chave de idempotencia do provedor,
  /// nunca a chave do cliente.
  operationId String @unique @map("operation_id") @db.VarChar(40)

  responseStatus  Int?    @map("response_status")
  responseBody    Json?   @map("response_body")
  responseHeaders Json?   @map("response_headers")
  errorCode       String? @map("error_code") @db.VarChar(64)

  lockedBy       String?   @map("locked_by") @db.VarChar(64)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  /// IN_FLIGHT com lease vencido e abandonado e pode ser roubado, mas quem
  /// rouba PRECISA rodar o caminho de conciliacao antes de reexecutar.
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([environment, endpointKey, key])
  @@index([expiresAt])
  @@index([state, leaseExpiresAt])
  @@map("idempotency_record")
}

enum OperationStatus {
  PENDING
  SUBMITTED
  UNKNOWN
  SETTLED
  FAILED
}

/// Operacao contra o provedor.
///
/// Torna durável e consultavel o estado de uma escrita cujo desfecho e
/// indeterminado. Sem esta tabela, um timeout num PIX out so poderia ser
/// resolvido reenviando o pagamento.
model ProviderOperation {
  id           String      @id @db.VarChar(40)
  environment  Environment
  connectionId String      @map("connection_id") @db.VarChar(40)
  kind         String      @db.VarChar(48)
  /// Derivada do nosso operationId, nunca da chave do cliente.
  providerIdempotencyKey String @map("provider_idempotency_key") @db.VarChar(255)

  status        OperationStatus @default(PENDING)
  requestDigest String          @map("request_digest") @db.VarChar(64)
  providerRef   String?         @map("provider_ref") @db.VarChar(128)
  endToEndId    String?         @map("end_to_end_id") @db.VarChar(32)
  amountCents   BigInt?         @map("amount_cents")
  accountId     String?         @map("account_id") @db.VarChar(40)

  attempts   Int       @default(0)
  lastError  Json?     @map("last_error")
  nextTryAt  DateTime? @map("next_try_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([connectionId, providerIdempotencyKey])
  @@index([status, updatedAt])
  @@index([environment, endToEndId])
  @@map("provider_operation")
}

enum InboundEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  DISCARDED
  FAILED
  DEAD_LETTER
}

/// Webhook de entrada.
///
/// Persistido ANTES de enfileirar: perda de Redis custa latencia, nunca dado.
/// Um sweeper reenfileira o que ficar RECEIVED por mais de 60 segundos.
model InboundWebhookEvent {
  id              String       @id @db.VarChar(40)
  environment     Environment
  connectionId    String       @map("connection_id") @db.VarChar(40)
  provider        ProviderSlug
  /// providerEventId, ou sha256 do corpo quando o provedor nao da id.
  dedupeKey       String       @map("dedupe_key") @db.VarChar(128)
  providerEventId String?      @map("provider_event_id") @db.VarChar(128)
  eventTypeRaw    String?      @map("event_type_raw") @db.VarChar(128)

  occurredAt DateTime? @map("occurred_at") @db.Timestamptz(6)
  receivedAt DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  /// Redigidos. Os bytes crus so ficam como digest.
  headers   Json
  payload   Json
  rawSha256 String  @map("raw_sha256") @db.VarChar(64)
  signatureValid Boolean @map("signature_valid")

  status      InboundEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  lastError   Json?              @map("last_error")
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)

  @@unique([connectionId, dedupeKey])
  @@index([status, receivedAt])
  @@index([environment, receivedAt])
  @@map("inbound_webhook_event")
}

/// Outbox transacional.
///
/// Inserido na MESMA transacao da mudanca de dominio. E a unica forma de
/// garantir que nunca contamos ao cliente um pagamento que nao registramos, e
/// nunca deixamos de contar um que registramos.
model OutboxEvent {
  id          String      @id @db.VarChar(40)
  environment Environment
  type        String      @db.VarChar(64)
  dataVersion Int         @default(1) @map("data_version")
  provider    ProviderSlug?
  connectionId String?    @map("connection_id") @db.VarChar(40)

  subjectKind String @map("subject_kind") @db.VarChar(48)
  subjectId   String @map("subject_id") @db.VarChar(40)
  /// Monotonico por ambiente: o consumidor detecta evento perdido pela lacuna.
  sequence    BigInt @default(autoincrement())

  payload  Json
  previous Json?

  occurredAt   DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)

  deliveries WebhookDelivery[]

  @@index([dispatchedAt, id])
  @@index([environment, subjectKind, subjectId, sequence])
  @@map("outbox_event")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  DISABLED_BY_FAILURES
}

model WebhookEndpoint {
  id          String      @id @db.VarChar(40)
  environment Environment
  url         String      @db.VarChar(1024)
  description String?     @db.VarChar(255)
  /// Suporta glob: 'pix.*' e '*'.
  eventTypes  String[]    @default([]) @map("event_types")

  secretCiphertext Bytes  @map("secret_ciphertext")
  secretIv         Bytes  @map("secret_iv")
  secretTag        Bytes  @map("secret_tag")
  secretWrappedKey Bytes  @map("secret_wrapped_key")
  secretKeyId      String @map("secret_key_id") @db.VarChar(255)
  /// Segredo anterior, valido por 24h durante a rotacao: as duas assinaturas
  /// sao enviadas para o cliente rotacionar sem perder evento.
  previousSecretCiphertext Bytes?    @map("previous_secret_ciphertext")
  previousSecretIv         Bytes?    @map("previous_secret_iv")
  previousSecretTag        Bytes?    @map("previous_secret_tag")
  previousSecretWrappedKey Bytes?    @map("previous_secret_wrapped_key")
  previousSecretKeyId      String?   @map("previous_secret_key_id") @db.VarChar(255)
  previousSecretExpiresAt  DateTime? @map("previous_secret_expires_at") @db.Timestamptz(6)

  status              SubscriptionStatus @default(ACTIVE)
  consecutiveFailures Int                @default(0) @map("consecutive_failures")
  disabledAt          DateTime?          @map("disabled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries WebhookDelivery[]

  @@index([environment, status])
  @@map("webhook_endpoint")
}

enum DeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXHAUSTED
}

model WebhookDelivery {
  id         String @id @db.VarChar(40)
  eventId    String @map("event_id") @db.VarChar(40)
  endpointId String @map("endpoint_id") @db.VarChar(40)
  attempt    Int    @default(1)

  status              DeliveryStatus @default(PENDING)
  requestBodySha256   String?        @map("request_body_sha256") @db.VarChar(64)
  responseStatus      Int?           @map("response_status")
  /// Primeiros 2 KB, redigidos.
  responseBodySnippet String?        @map("response_body_snippet") @db.VarChar(2048)
  durationMs          Int?           @map("duration_ms")
  error               String?        @db.VarChar(512)

  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  attemptedAt  DateTime? @map("attempted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event    OutboxEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([eventId, endpointId, attempt])
  @@index([status, scheduledFor])
  @@map("webhook_delivery")
}

/// Cursor de polling.
///
/// Para provedores sem webhook, e como rede de seguranca para os que tem: um
/// webhook perdido e silencioso, e um PIX in perdido e incidente visivel.
/// A janela `lapSeconds` garante sobreposicao, e as duplicatas resultantes sao
/// absorvidas pelo guard monotonico. Isso e o design, nao um bug.
model PollCursor {
  id           String  @id @db.VarChar(40)
  connectionId String  @map("connection_id") @db.VarChar(40)
  stream       String  @db.VarChar(48)
  scopeId      String? @map("scope_id") @db.VarChar(40)

  cursor     String?  @db.VarChar(512)
  watermark  DateTime @db.Timestamptz(6)
  lapSeconds Int      @default(300) @map("lap_seconds")

  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastError Json?     @map("last_error")

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, stream, scopeId])
  @@map("poll_cursor")
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

/// Trilha de auditoria append-only com cadeia de hash.
///
/// Migrations cruas adicionam:
///   - REVOKE UPDATE, DELETE ON audit_log FROM baas_app
///   - trigger BEFORE UPDATE OR DELETE que levanta excecao, independente do papel
///   - trigger BEFORE INSERT que calcula rowHash = sha256(payload || prevHash)
///   - particionamento mensal por RANGE (recorded_at)
///
/// Apagar ou alterar uma linha quebra a cadeia e e detectavel por
/// GET /admin/v1/audit/verify.
model AuditLog {
  id          String      @id @db.VarChar(40)
  environment Environment
  sequence    BigInt      @default(autoincrement())

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  actorType      ActorType @map("actor_type")
  actorId        String?   @map("actor_id") @db.VarChar(128)
  actorLabel     String?   @map("actor_label") @db.VarChar(255)
  actorIp        String?   @map("actor_ip") @db.Inet
  actorUserAgent String?   @map("actor_user_agent") @db.VarChar(512)

  action    String       @db.VarChar(96)
  outcome   AuditOutcome @default(SUCCESS)
  errorCode String?      @map("error_code") @db.VarChar(64)

  resourceType String  @map("resource_type") @db.VarChar(48)
  resourceId   String? @map("resource_id") @db.VarChar(40)
  connectionId String? @map("connection_id") @db.VarChar(40)
  provider     ProviderSlug?

  /// Ja redigidos: valor sensivel nunca chega a esta tabela em claro.
  before        Json?
  after         Json?
  changedFields String[] @default([]) @map("changed_fields")

  requestId       String?  @map("request_id") @db.VarChar(40)
  operationId     String?  @map("operation_id") @db.VarChar(40)
  providerCallIds String[] @default([]) @map("provider_call_ids")

  /// Cadeia de hash: prevHash aponta para o rowHash da linha anterior.
  prevHash Bytes? @map("prev_hash")
  rowHash  Bytes  @map("row_hash")

  @@index([environment, occurredAt(sort: Desc)])
  @@index([environment, resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([environment, actorType, actorId, occurredAt(sort: Desc)])
  @@index([requestId])
  @@map("audit_log")
}

/// Ancoragem diaria da cadeia de auditoria.
///
/// A cabeca da cadeia e assinada e gravada em objeto com Object Lock. Nem um
/// comprometimento total do banco reescreve o historico sem contradizer as
/// ancoras.
model AuditAnchor {
  id          String      @id @db.VarChar(40)
  environment Environment
  asOfDate    DateTime    @map("as_of_date") @db.Date
  headSequence BigInt     @map("head_sequence")
  headHash    Bytes       @map("head_hash")
  signature   Bytes?
  externalRef String?     @map("external_ref") @db.VarChar(512)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([environment, asOfDate])
  @@map("audit_anchor")
}

/// Registro de chamada ao provedor.
///
/// Alto volume e retencao curta (90 dias quentes). Voltado a engenharia e ao
/// suporte: e a tela mais valiosa quando um pagamento da errado.
model ProviderCall {
  id           String      @id @db.VarChar(40)
  environment  Environment
  connectionId String      @map("connection_id") @db.VarChar(40)
  provider     ProviderSlug

  correlationId String? @map("correlation_id") @db.VarChar(40)
  operationId   String? @map("operation_id") @db.VarChar(40)

  method        String @db.VarChar(8)
  path          String @db.VarChar(512)
  endpointClass String @map("endpoint_class") @db.VarChar(16)

  requestHeaders Json  @map("request_headers")
  requestBody    Json? @map("request_body")
  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")
  providerRequestId String? @map("provider_request_id") @db.VarChar(128)

  durationMs        Int     @map("duration_ms")
  attempts          Int     @default(1)
  outcome           String  @db.VarChar(24)
  canonicalErrorCode String? @map("canonical_error_code") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([environment, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([operationId])
  @@map("provider_call")
}
