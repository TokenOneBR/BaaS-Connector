{
  "name": "@baasconn/observability",
  "version": "0.1.0",
  "description": "Bootstrap compartilhado de log com redacao, tracing OpenTelemetry e metricas Prometheus",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@baasconn/taxonomy": "workspace:*",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@baasconn/tsconfig": "workspace:*",
    "@baasconn/vitest-config": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
