{
  "name": "@baasconn/adapter-kit",
  "version": "0.1.0",
  "description": "Ferramentaria para autores de adapter: HTTP com retry e circuit breaker, estrategias de autenticacao, redacao, mapeamento de erro e CassetteServer",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@baasconn/provider-spi": "workspace:*",
    "@baasconn/taxonomy": "workspace:*",
    "undici": "^7.2.0"
  },
  "devDependencies": {
    "@baasconn/tsconfig": "workspace:*",
    "@baasconn/vitest-config": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
