{
  "name": "@baasconn/sdk",
  "version": "0.1.0",
  "description": "Cliente TypeScript da API canonica do BaaS Connector",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TokenOneBR/BaaS-Connector.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@baasconn/contracts": "workspace:*",
    "@baasconn/crypto": "workspace:*",
    "@baasconn/taxonomy": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@baasconn/eslint-config": "workspace:*",
    "@baasconn/tsconfig": "workspace:*",
    "@baasconn/vitest-config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
