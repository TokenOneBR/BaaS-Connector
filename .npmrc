# Proveniencia em todo publish.
#
# Liga o pacote publicado ao commit e ao workflow que o construiu, de forma
# verificavel por quem instala. Depende do OIDC do `release.yml` — e por isso
# que NAO existe `NPM_TOKEN` neste repositorio: nao ha credencial de longa
# duracao para roubar.
provenance=true

# Sem `auto-install-peers`: uma peer dependency que o pnpm resolve sozinho e
# uma dependencia que ninguem declarou e que some no proximo `install` de
# outra pessoa.
auto-install-peers=false
strict-peer-dependencies=false
